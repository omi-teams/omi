{
  "model": "sonnet",
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "python -m omi status" }] }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "python -m omi guard" }]
      }
    ]
  }
}
